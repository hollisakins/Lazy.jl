#!/bin/bash

export JULIA_LOAD_PATH="@lazy"

args=()
cmd=$1
if [ -z "$cmd" ]; then
    echo "Usage: $0 <command> [args]" >&2
    echo "Available commands: fit, params, list-templates, list-filters" >&2
    exit 1
fi

# Skip past the command
args+=("$cmd")
shift 

nthreads=1  # Default number of threads
while [ "$#" -gt 0 ]; do
    case "$1" in
        -t|--threads)
            shift
            nthreads="$1"
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

julia -t $nthreads --project=@lazy -m Lazy "${args[@]}"
